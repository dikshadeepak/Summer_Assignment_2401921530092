// 1. Interface
interface Test {
    int square(int n);
}

// Arithmetic class implementing interface
class Arithmetic implements Test {
    public int square(int n) {
        return n * n;
    }
}

// 2. Outer class with Inner class
class Outer {

    void display() {
        System.out.println("Display method of Outer class");
    }

    class Inner {
        void display() {
            System.out.println("Display method of Inner class");
        }
    }
}

// 3. Point class
class Point {

    private int x, y;

    // Default constructor
    public Point() {
        x = 0;
        y = 0;
    }

    // Parameterized constructor
    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void setX(int x) {
        this.x = x;
    }

    public void setY(int y) {
        this.y = y;
    }

    public void setXY(int x, int y) {
        this.x = x;
        this.y = y;
    }

    void displayPoint() {
        System.out.println("Point = (" + x + ", " + y + ")");
    }
}

// 4. Box class
class Box {

    double length, breadth;

    Box(double length, double breadth) {
        this.length = length;
        this.breadth = breadth;
    }

    void area() {
        System.out.println("Area = " + (length * breadth));
    }
}

// Box3D class extending Box
class Box3D extends Box {

    double height;

    Box3D(double length, double breadth, double height) {
        super(length, breadth);
        this.height = height;
    }

    void volume() {
        System.out.println("Volume = " + (length * breadth * height));
    }
}

// Main class
public class Main {

    public static void main(String[] args) {

        // Question 1
        System.out.println("----- Interface Example -----");
        Arithmetic a = new Arithmetic();
        System.out.println("Square of 6 = " + a.square(6));

        // Question 2
        System.out.println("\n----- Outer & Inner Class -----");
        Outer o = new Outer();
        o.display();

        Outer.Inner in = o.new Inner();
        in.display();

        // Question 3
        System.out.println("\n----- Point Class -----");
        Point p1 = new Point();
        p1.displayPoint();

        Point p2 = new Point(10, 20);
        p2.displayPoint();

        p1.setX(5);
        p1.setY(8);
        p1.displayPoint();

        p1.setXY(15, 25);
        p1.displayPoint();

        // Question 4
        System.out.println("\n----- Box & Box3D -----");
        Box b = new Box(5, 4);
        b.area();

        Box3D b3 = new Box3D(5, 4, 3);
        b3.area();
        b3.volume();
    }
}
